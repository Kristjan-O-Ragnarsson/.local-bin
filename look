#!/usr/bin/env bash
# look: ls for directories, a viewer for files
DIR_CMD=${LOOK_DIR_CMD:-ls -la}
FILE_CMD=${LOOK_FILE_CMD:-bat}

[ $# -eq 0 ] && set -- .

status=0
for target in "$@"; do
  if [ -d "$target" ]; then
    [ $# -gt 1 ] && printf '\n==> %s/ <==\n' "$target"
    $DIR_CMD "$target"
  elif [ -e "$target" ]; then
    $FILE_CMD "$target"
  else
    echo "look: $target: no such file or directory" >&2
    status=1
  fi
done
exit $status
